# Пример переменных окружения. Скопируйте в .env и заполните. НЕ коммитьте .env.
# На платформе хакатона адрес и ключ подставляются автоматически.

# OpenAI-совместимый API (локально — OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Модели организаторов (ID для OpenRouter)
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Необязательно
# DATA_DIR=data
# TEMPERATURE=0
# MAX_TOKENS=4096
# MAX_WORKERS=8
# DEV_CACHE=1          # дисковый кэш ответов API (только локальная разработка)
